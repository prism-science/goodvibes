   "source": [
    "springs_refinement = np.load('krefinement.npy')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "41b275fb-8fe4-4048-b479-05802fbcc5da",
   "metadata": {},
   "outputs": [],
   "source": [
    "# for building a check table\n",
    "kl = springs_refinement[-1].T[1]\n",
    "kt = springs_refinement[-1].T[0]\n",
    "r1 = np.array([np.array(np.array(df_symmetry['r1'])[i]) for i in range(155)])\n",
    "r2 = np.array([np.array(np.array(df_symmetry['r2'])[i]) for i in range(155)])\n",
    "\n",
    "for i in range(155):\n",
    "    if tuple(r2[i]) < tuple(r1[i]):\n",
    "        r1[i], r2[i] = r2[i].copy(), r1[i].copy()\n",
    "\n",
    "r1str = [tuple(r1[i]) for i in range(155)]\n",
    "r2str = [tuple(r2[i]) for i in range(155)]\n",
    "\n",
    "d = {\"kL\": kl, \"kT\": kt, \"r1\": r1str, \"r2\": r2str}\n",
    "to_steve = pd.DataFrame(data=d)\n",
    "to_steve = to_steve.sort_values(by=[\"r1\",\"r2\"], kind=\"mergesort\").reset_index(drop=True)\n",
    "to_steve.to_csv('tri_lysozyme_check.csv', index=False)"
   ]
  },
