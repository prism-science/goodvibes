       "  </div>\n",
       "</div>\n",
       "\n",
       "\n",
       "<script language=\"javascript\">\n",
       "  /* Instantiate the Animation class. */\n",
       "  /* The IDs given should match those used in the template above. */\n",
       "  (function() {\n",
       "    var img_id = \"_anim_img00303eb5894d421bb5a638e9f0c16858\";\n",
       "    var slider_id = \"_anim_slider00303eb5894d421bb5a638e9f0c16858\";\n",
       "    var loop_select_id = \"_anim_loop_select00303eb5894d421bb5a638e9f0c16858\";\n",
