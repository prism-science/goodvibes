       "}\n",
       "</style>\n",
       "\n",
       "<div class=\"animation\">\n",
       "  <img id=\"_anim_img00303eb5894d421bb5a638e9f0c16858\">\n",
       "  <div class=\"anim-controls\">\n",
       "    <input id=\"_anim_slider00303eb5894d421bb5a638e9f0c16858\" type=\"range\" class=\"anim-slider\"\n",
       "           name=\"points\" min=\"0\" max=\"1\" step=\"1\" value=\"0\"\n",
       "           oninput=\"anim00303eb5894d421bb5a638e9f0c16858.set_frame(parseInt(this.value));\">\n",
       "    <div class=\"anim-buttons\">\n",
