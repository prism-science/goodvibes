       "          <i class=\"fa fa-minus\"></i></button>\n",
       "      <button title=\"First frame\" aria-label=\"First frame\" onclick=\"anim00303eb5894d421bb5a638e9f0c16858.first_frame()\">\n",
       "        <i class=\"fa fa-fast-backward\"></i></button>\n",
       "      <button title=\"Previous frame\" aria-label=\"Previous frame\" onclick=\"anim00303eb5894d421bb5a638e9f0c16858.previous_frame()\">\n",
       "          <i class=\"fa fa-step-backward\"></i></button>\n",
       "      <button title=\"Play backwards\" aria-label=\"Play backwards\" onclick=\"anim00303eb5894d421bb5a638e9f0c16858.reverse_animation()\">\n",
       "          <i class=\"fa fa-play fa-flip-horizontal\"></i></button>\n",
       "      <button title=\"Pause\" aria-label=\"Pause\" onclick=\"anim00303eb5894d421bb5a638e9f0c16858.pause_animation()\">\n",
       "          <i class=\"fa fa-pause\"></i></button>\n",
       "      <button title=\"Play\" aria-label=\"Play\" onclick=\"anim00303eb5894d421bb5a638e9f0c16858.play_animation()\">\n",
       "          <i class=\"fa fa-play\"></i></button>\n",
       "      <button title=\"Next frame\" aria-label=\"Next frame\" onclick=\"anim00303eb5894d421bb5a638e9f0c16858.next_frame()\">\n",
       "          <i class=\"fa fa-step-forward\"></i></button>\n",
       "      <button title=\"Last frame\" aria-label=\"Last frame\" onclick=\"anim00303eb5894d421bb5a638e9f0c16858.last_frame()\">\n",
       "          <i class=\"fa fa-fast-forward\"></i></button>\n",
       "      <button title=\"Increase speed\" aria-label=\"Increase speed\" onclick=\"anim00303eb5894d421bb5a638e9f0c16858.faster()\">\n",
       "          <i class=\"fa fa-plus\"></i></button>\n",
       "    </div>\n",
       "    <form title=\"Repetition mode\" aria-label=\"Repetition mode\" action=\"#n\" name=\"_anim_loop_select00303eb5894d421bb5a638e9f0c16858\"\n",
       "          class=\"anim-state\">\n",
       "      <input type=\"radio\" name=\"state\" value=\"once\" id=\"_anim_radio1_00303eb5894d421bb5a638e9f0c16858\"\n",
       "             >\n",
       "      <label for=\"_anim_radio1_00303eb5894d421bb5a638e9f0c16858\">Once</label>\n",
       "      <input type=\"radio\" name=\"state\" value=\"loop\" id=\"_anim_radio2_00303eb5894d421bb5a638e9f0c16858\"\n",
       "             checked>\n",
       "      <label for=\"_anim_radio2_00303eb5894d421bb5a638e9f0c16858\">Loop</label>\n",
       "      <input type=\"radio\" name=\"state\" value=\"reflect\" id=\"_anim_radio3_00303eb5894d421bb5a638e9f0c16858\"\n",
       "             >\n",
       "      <label for=\"_anim_radio3_00303eb5894d421bb5a638e9f0c16858\">Reflect</label>\n",
