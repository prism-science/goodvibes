    "def rotation_matrix_small(theta):\n",
    "    \"\"\"\n",
    "    Rodrigues rotation matrix for visualization.\n",
    "    \"\"\"\n",
    "\n",
    "    angle = np.linalg.norm(theta)\n",
    "\n",
    "    if angle < 1e-12:\n",
    "        return np.eye(3)\n",
    "\n",
    "    axis = theta / angle\n",
    "\n",
    "    X = cross_matrix(axis)\n",
    "\n",
    "    return (\n",
    "        np.eye(3)\n",
    "        + np.sin(angle) * X\n",
    "        + (1.0 - np.cos(angle)) * (X @ X)\n",
    "    )"
   ]
  },
